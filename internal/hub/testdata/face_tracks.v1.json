{
  "key": "face_tracks",
  "version": 1,
  "title": "Face Tracks",
  "desc": "Portable offline AuraFace face tracks.",
  "data_type": "json",
  "format": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "schema_version",
        "media",
        "embedding_space",
        "tracks",
        "observations",
        "embeddings",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "media": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "stream_index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "embedding_space": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "track_id",
              "start",
              "end",
              "person_id",
              "label",
              "score",
              "embedding",
              "candidates",
              "score_type"
            ],
            "properties": {
              "track_id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "person_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "score_type": {
                "const": "cosine_similarity"
              },
              "embedding": {
                "type": "array",
                "minItems": 512,
                "maxItems": 512,
                "items": {
                  "type": "number"
                }
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "person_id",
                    "label",
                    "score"
                  ],
                  "properties": {
                    "person_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "score": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "observations": {
          "type": "array"
        },
        "embeddings": {
          "type": "object",
          "required": [
            "artifact",
            "sha256",
            "shape",
            "dtype"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "provenance": {
          "type": "object"
        }
      }
    }
  }
}
